{
  "name": "glcm-texture-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GLCM texture analysis: C++ core, Node-API addon, web API server",
  "workspaces": [
    "packages/api",
    "bindings/node",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:native": "npm run build -w @glcm/native",
    "build:web": "npm run build -w @glcm/web",
    "dev:web": "npm run dev -w @glcm/web",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "start": "npm run start -w @glcm/server",
    "dev": "npm run dev -w @glcm/server",
    "openapi": "npm run openapi -w @glcm/server",
    "samples": "tsx scripts/generate-samples.ts",
    "test:e2e": "npm run build:web && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.5.1",
    "@types/pngjs": "6.0.5",
    "cmake-js": "8.0.0",
    "node-addon-api": "8.9.2",
    "pngjs": "7.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
