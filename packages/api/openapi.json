    "/api/v1/images/{id}/pixel": {
      "get": {
        "summary": "One grayscale value",
        "tags": [
          "images"
        ],
        "description": "Used for the hover readout of images that are too large for GET /raw.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "in": "query",
            "name": "x",
            "required": true
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "in": "query",
            "name": "y",
            "required": true
          },
