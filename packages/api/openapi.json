    "/api/v1/images/{id}/display.png": {
      "get": {
        "summary": "8-bit rendering with window/level",
        "tags": [
          "images"
        ],
        "description": "Intensities are mapped with the integer window/level formula shared with the browser renderer (doc/ui-design-plan.md, section 6.1) and downscaled so the long side is at most maxSize.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "in": "query",
            "name": "min",
            "required": false,
            "description": "Window minimum; default windowMin"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "in": "query",
            "name": "max",
            "required": false,
            "description": "Window maximum; default windowMax"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "in": "query",
            "name": "maxSize",
            "required": false,
            "description": "Largest long side; capped by the server limit"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^img_[0-9a-f]{32}$"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Image id returned by POST /images"
          }
        ],
        "responses": {
          "200": {
            "description": "PNG image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (no body)"
          },
          "400": {
            "description": "Error returned by every endpoint for 4xx and 5xx responses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Machine-readable error code, e.g. \"NotFound\" or \"PayloadTooLarge\""
                    },
                    "message": {
                      "type": "string",
                      "description": "Human-readable description"
                    }
                  },
                  "description": "Error returned by every endpoint for 4xx and 5xx responses"
                }
              }
            }
          },
          "404": {
            "description": "Error returned by every endpoint for 4xx and 5xx responses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "message"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Machine-readable error code, e.g. \"NotFound\" or \"PayloadTooLarge\""
