    "/api/v1/images/{id}/raw": {
      "get": {
        "summary": "Raw grayscale samples",
        "tags": [
          "images"
        ],
        "description": "Row-major samples from the top-left pixel, no header; 16-bit samples are little-endian. Size and format are in the X-Image-Width, X-Image-Height, X-Image-Bit-Depth and X-Image-Byte-Order headers. Compressed with zstd or gzip when accepted. Only for images with transfer \"raw\" (409 otherwise).",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^img_[0-9a-f]{32}$"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Image id returned by POST /images"
          }
        ],
        "responses": {
          "200": {
            "description": "Grayscale samples",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "Not modified (no body)"
          },
          "400": {
            "description": "Error returned by every endpoint for 4xx and 5xx responses",
            "content": {
